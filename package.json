{
  "name": "dev-stack",
  "version": "0.0.1",
  "private": true,
  "description": "Unified dev toolchain — dev-engine, design-system knowledge base, and Claude skills",
  "packageManager": "pnpm@11.1.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build && pnpm build:skills",
    "build:skills": "pnpm check:refs && bash scripts/build-skills.sh",
    "check:refs": "node scripts/check-refs.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm check:refs && pnpm -r test"
  }
}
